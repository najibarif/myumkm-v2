generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model business_profiles {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_name        String
  description          String?
  category             String
  location             String?
  user_id              String                 @unique @db.Uuid
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_business_user")
  marketplace_listings marketplace_listings[]
}

model conversation_users {
  conversation_id String        @db.Uuid
  user_id         String        @db.Uuid
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversation_user_conversation")
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversation_user_user")

  @@id([conversation_id, user_id])
}

model conversations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deleted            Boolean?             @default(false)
  deleted_at         DateTime?            @db.Timestamptz(6)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  conversation_users conversation_users[]
  messages           messages[]
}

model forum_comments {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content     String
  author_id   String      @db.Uuid
  post_id     String      @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  forum_posts forum_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_forum_comment_post")
  users       users       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_forum_comment_user")

  @@index([author_id], map: "idx_forum_comments_author")
  @@index([post_id], map: "idx_forum_comments_post")
}

model forum_posts {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  content        String
  author_id      String           @db.Uuid
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  forum_comments forum_comments[]
  users          users            @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_forum_post_user")

  @@index([author_id], map: "idx_forum_posts_author")
}

model marketplace_listings {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  description       String
  price             Decimal           @db.Decimal
  category          String
  owner_id          String            @db.Uuid
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  business_profiles business_profiles @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_marketplace_business")

  @@index([owner_id], map: "idx_marketplace_owner")
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content         String
  deleted         Boolean?      @default(false)
  deleted_at      DateTime?     @db.Timestamptz(6)
  author_id       String        @db.Uuid
  conversation_id String        @db.Uuid
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  users           users         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_author")
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_conversation")

  @@index([author_id], map: "idx_messages_author")
  @@index([conversation_id], map: "idx_messages_conversation")
}

model users {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String               @unique
  password           String
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  business_profiles  business_profiles?
  conversation_users conversation_users[]
  forum_comments     forum_comments[]
  forum_posts        forum_posts[]
  messages           messages[]
}
